# Comma-separated live Telegraph miner base URLs (HTTPS, no trailing slash)
# Default includes the Track 1 Groq miner — replace/add catalog miners as needed.
MINER_BASE_URLS=https://telegraph-miner-node.onrender.com

# Optional display names aligned 1:1 with MINER_BASE_URLS
MINER_NAMES=Telegraph Groq LPU Miner

# Paths to try on each miner (first success wins per miner)
MINER_CHAT_PATHS=/chat,/v1/chat/completions

# Timeouts
MINER_TIMEOUT_SECONDS=45

# Bind
HOST=0.0.0.0
PORT=8080
