# Primary miner(s) — yours first (always included; used as direct fallback)
MINER_BASE_URLS=https://telegraph-miner-node.onrender.com
MINER_NAMES=Telegraph Groq LPU Miner

# Paths to try on each miner (direct HTTPS fallback)
MINER_CHAT_PATHS=/chat,/v1/chat/completions
MINER_TIMEOUT_SECONDS=45

# Discover other miners from Telegraph node catalog, then query in parallel
DISCOVERY_ENABLED=true
TELEGRAPH_NODE_URL=http://13.237.89.59:7044
DISCOVERY_TIMEOUT_SECONDS=8
MAX_JURY_SIZE=4
DISCOVERY_REQUIRE_HTTPS=true

# Track 3 consume — Telegraph Engine ranked ask
# engine_first (default) | engine_only | direct
TELEGRAPH_CONSUME_MODE=engine_first
TELEGRAPH_ENGINE_URL=https://devnode.telegraphprotocol.com
# Optional: TELEGRAPH_MINER_ID=
# Optional x402: TELEGRAPH_PAYMENT_HEADER=

HOST=0.0.0.0
PORT=8080
